    // ── 状态字段 ──
    private final ExecutorService executor = Executors.newVirtualThreadPerTaskExecutor();
    private final AtomicReference<CalcResult> bestResult = new AtomicReference<>();
    private CompletableFuture<CalcResult> calcFuture;
    private final AtomicReference<Vec3d> lookTarget = new AtomicReference<>();

    private final Timer placeTimer = new Timer();
    private final Timer breakTimer = new Timer();
    private final Timer swapTimer = new Timer();
    private final Timer swapPenaltyTimer = new Timer();
    private final Timer rotationResetTimer = new Timer();
    private final Timer attackTimer = new Timer();      // 连续攻击同一水晶计数
    private final Timer baseTimer = new Timer();

    private final LinkedList<Long> placedTimestamps = new LinkedList<>();
    private final List<RenderPos> renderList = new ArrayList<>();
    private final Map<UUID, Long> firstSeenTime = new ConcurrentHashMap<>();
    private final Map<Integer, Boolean> serverDead = new ConcurrentHashMap<>();

    private volatile PlayerEntity target = null;
    private volatile PlayerEntity prevTarget = null;
    private volatile float currentDamage = 0f;
    private volatile BlockPos lastPlacedPos = null;
    private volatile BlockPos basePos = null;
    private volatile BlockPos breakTargetPos = null;
    private volatile int breakEntityId = -1;
    private volatile int consecutiveBreaks = 0;
    private volatile Vec3d rotationTarget = null;
    private volatile boolean placedThisCycle = false;    // Sequential STRICT 标志
    private volatile boolean skip = false;              // StrictTiming 隔拍
    private volatile boolean obsidianPickup = false;     // 目标捡黑曜石暂停
    private volatile int pendingBreakId = -1;            // Instant 待破坏的水晶实体 ID
    private int swapBackSlot = -1;

    // ── 内部数据结构 ──
    private static class CalcResult {
        final BlockPos pos;
        final PlayerEntity target;
        final double damage;
        final PlaceMode mode;

        CalcResult(BlockPos pos, PlayerEntity target, double damage, PlaceMode mode) {
            this.pos = pos;
            this.target = target;
            this.damage = damage;
            this.mode = mode;
        }
    }

    private static class TargetData {
        final PlayerEntity target;
        final double damage;
        final KillState killState;

        TargetData(PlayerEntity target, double damage, KillState killState) {
            this.target = target;
            this.damage = damage;
            this.killState = killState;
        }
    }

    private static class RenderPos {
        final BlockPos pos;
        final long time;

        RenderPos(BlockPos pos, long time) {
            this.pos = pos;
            this.time = time;
        }
    }

    public CrystalAuraPlusPlus() {
        super("CrystalAura++", "Mio AutoCrystal ported. Place/break end crystals.", Category.Combat);
        this.setChinese("水晶光环++");
        INSTANCE = this;
    }

    // ══════════════════════════ 生命周期 ══════════════════════════

    @Override
    public void onEnable() {
        target = null;
        prevTarget = null;
        bestResult.set(null);
        lookTarget.set(null);
        rotationTarget = null;
        lastPlacedPos = null;
        basePos = null;
        breakTargetPos = null;
        breakEntityId = -1;
        consecutiveBreaks = 0;
        placedThisCycle = false;
        skip = false;
        pendingBreakId = -1;
        renderList.clear();
        if (calcFuture != null) {
            calcFuture.complete(null);
            calcFuture = null;
        }
    }

    @Override
    public void onDisable() {
        if (calcFuture != null) {
            calcFuture.complete(null);
            calcFuture = null;
        }
        bestResult.set(null);
        lookTarget.set(null);
        rotationTarget = null;
        target = null;
        prevTarget = null;
        lastPlacedPos = null;
        breakTargetPos = null;
        pendingBreakId = -1;
        renderList.clear();
        if (swapBackSlot != -1) {
            InventoryUtil.switchToSlot(swapBackSlot);
            swapBackSlot = -1;
        }
    }

    @Override
    public String getInfo() {
        if (target == null || isInvalidTarget(target)) return null;
        return String.format("%s §7%.1f", target.getGameProfile().getName(), currentDamage);
    }

    // ══════════════════════════ 事件 ══════════════════════════

    @EventListener
    public void onTick(ClientTickEvent event) {
        if (event.isPost()) return;
        if (nullCheck()) return;

        placedThisCycle = false;   // Sequential 每 tick 复位

        // 放置时间戳清理
        if (mc.player.age % 4 == 0) {
            long now = System.currentTimeMillis();
            while (!placedTimestamps.isEmpty() && now - placedTimestamps.peek() > 1000) {
                placedTimestamps.poll();
            }
        }

        // 记录首次见到时间（无敌超时用）
        for (PlayerEntity p : mc.world.getPlayers()) {
            firstSeenTime.putIfAbsent(p.getUuid(), System.currentTimeMillis());
        }

        // 异步结果交接 + 启动下一轮（管线常满）
        if (calcFuture != null && calcFuture.isDone()) {
            try {
                CalcResult result = calcFuture.get();
                bestResult.set(result);
                if (result != null) {
                    currentDamage = (float) result.damage;
                    if (result.target != null) {
                        prevTarget = target;
                        target = result.target;
                    }
                } else {
                    currentDamage = 0f;
                }
            } catch (Exception e) {
                bestResult.set(null);
                currentDamage = 0f;
            }
        }
        if (calcFuture == null || calcFuture.isDone() || calcFuture.isCancelled()) {
            launchCalc();
        }

        // 目标失效清理
        if (isInvalidTarget(target)) {
            target = null;
        }

        if (isPaused()) return;

        // 旋转复位
        if (rotationResetTimer.passedMs(500)) {
            rotationTarget = null;
        }

        checkObsidianPickup();

        // 放置
        if (place.getValue() && placeTimer.passedMs(placeDelay.getValue())) {
            doPlace();
        }

        // 破坏
        if (breakEnabled.getValue() && breakTimer.passedMs(breakDelay.getValue())) {
            doBreak();
        }
    }

    @EventListener
    public void onRotate(RotationEvent event) {
        if (rotationResetTimer.passedMs(500)) {
            rotationTarget = null;
        }
        if (rotationTarget != null) {
            event.setTarget(rotationTarget, 1.0F, 100.0F);
        }
    }

    @EventListener
    public void onReceivePacket(PacketEvent.Receive event) {
        if (nullCheck()) return;
        Object packet = event.getPacket();
        if (packet instanceof EntitySpawnS2CPacket spawn) {
            if (spawn.getEntityType() == EntityType.END_CRYSTAL) {
                handleCrystalSpawn(spawn);
            }
        } else if (packet instanceof EntityStatusS2CPacket status) {
            if (status.getStatus() == 3) {
                Entity dead = status.getEntity(mc.world);
                if (dead != null) serverDead.put(dead.getId(), true);
            }
        } else if (packet instanceof DeathMessageS2CPacket) {
            forceSuicide.setValue(false);
        }
    }

    @EventListener
    public void onEntitySpawn(EntitySpawnedEvent event) {
        if (!(event.getEntity() instanceof EndCrystalEntity crystal)) return;
        // 只破坏 handleCrystalSpawn 判定要破的水晶（addEntity TAIL 才可拿到实体）
        if (pendingBreakId != -1 && pendingBreakId == crystal.getId()) {
            pendingBreakId = -1;
            if (target == null || isInvalidTarget(target)) return;
            if (breakRotate.getValue() && rotate.getValue()) {
                setRotationTarget(crystal.getPos());
            }
            attackCrystal(crystal);
        }
    }

    // ══════════════════════════ 异步搜索 ══════════════════════════

    private void launchCalc() {
        calcFuture = CompletableFuture.supplyAsync(this::calcAndReturn, executor)
                .exceptionally(e -> {
                    e.printStackTrace();
                    return null;
                });
    }

    /** 虚拟线程执行：全 3D 方块搜索 + 伤害计算，返回不可变快照 */
    private CalcResult calcAndReturn() {
        if (mc == null || mc.world == null || mc.player == null) return null;

        int predict = predictTicks();
        double range = placeRange.getValue();
        boolean allowBase = basePlace.getValue() && shouldBasePlace();

        // 上一轮结果位置优先复算
        CalcResult prev = bestResult.get();
        CalcResult prevRecheck = null;
        if (prev != null && prev.pos != null && prev.target != null && !isInvalidTarget(prev.target)) {
            prevRecheck = evaluatePos(prev.pos, allowBase, predict);
        }

        CalcResult best = null;
        int floor = (int) Math.floor(range);
        int ceil = (int) Math.ceil(range);

        for (int dx = -floor; dx <= ceil; dx++) {
            for (int dy = -floor; dy <= ceil; dy++) {
                for (int dz = -floor; dz <= ceil; dz++) {
                    BlockPos pos = BlockPos.ofFloored(mc.player.getX() + dx, mc.player.getEyeY() + dy, mc.player.getZ() + dz);
                    boolean solidBase = isSolidBase(pos);
                    if (best != null && best.mode != PlaceMode.Obsidian && !solidBase) continue;
                    if (mc.player.getEyePos().distanceTo(pos.toCenterPos()) > range) continue;
                    if (!isPosValid(pos, allowBase, predict)) continue;
                    CalcResult candidate = evaluatePos(pos, allowBase, predict);
                    if (candidate != null && better(candidate, best)) {
                        best = candidate;
                    }
                }
            }
        }

        if (prevRecheck != null && better(prevRecheck, best)) {
            best = prevRecheck;
        }
        return best;
    }

    /** 评估一个放置位置：伤害 + 目标筛选 + 模式 */
    private CalcResult evaluatePos(BlockPos pos, boolean allowBase, int predict) {
        boolean solidBase = isSolidBase(pos);
        boolean visible = isMultipointVisible(pos);
        double dist = mc.player.getEyePos().distanceTo(pos.toCenterPos());

        double selfDamage = damageAtPlace(explosionPos(pos), mc.player, predict, pos);
        TargetData targetData = getBestTargetForPos(pos, solidBase, predict);

        if (targetData == null) return null;

        PlayerEntity tgt = targetData.target;
        double dmg = targetData.damage;
        KillState kill = targetData.killState;

        if (isSuicide(false, selfDamage, dmg, kill, tgt)) return null;

        PlaceMode mode = PlaceMode.None;
        if (!visible && dist > placeWallRange.getValue()) {
            mode = PlaceMode.RayTrace;
        }
        if (allowBase && !solidBase) {
            // 底座放置分支
            Box targetBox = getPredictBox(tgt, predict).union(tgt.getBoundingBox());
            if (targetBox.intersects(new Box(pos))) {
                return null;
            }
            if (mc.world.getBlockState(pos).isReplaceable() == false || BlockUtil.hasEntity(pos, false)) {
                return null;
            }
            if (!airPlace.getValue() && BlockUtil.getClickSideStrict(pos) == null) {
                return null;
            }
            mode = PlaceMode.Obsidian;
        }
        return new CalcResult(pos, tgt, dmg, mode);
    }

    /** 目标比较：模式越低越优先，同级伤害高者胜 */
    private boolean better(CalcResult candidate, CalcResult current) {
        if (current == null) return true;
        if (candidate.mode.ordinal() < current.mode.ordinal()) return true;
        if (candidate.mode.ordinal() > current.mode.ordinal()) return false;
        return candidate.damage > current.damage;
    }

    /** 目标选择（getAutoCrystalData_41147）：该位置能打到的最优敌人 */
    private TargetData getBestTargetForPos(BlockPos pos, boolean solidBase, int predict) {
        TargetData best = null;
        for (PlayerEntity p : Forever.THREAD.getPlayers()) {
            if (p == mc.player) continue;
            if (isInvalidTarget(p)) continue;
            if (!(pos.getY() <= p.getY() + 1.5 || solidBase)) continue;

            Box box = getPredictBox(p, predict);
            double dmg = damageAtPlace(explosionPos(pos), p, predict, pos);
            KillState kill = getKillState(p, dmg);

            if (ignoreNakeds.getValue() && !hasArmor(p)) continue;

            Vec3d targetCenter = new Vec3d(MathHelper.lerp(0.5, box.minX, box.maxX), box.minY, MathHelper.lerp(0.5, box.minZ, box.maxZ));
            if (targetCenter.distanceTo(Vec3d.ofBottomCenter(pos)) > crystalRange.getValue() && !kill.flag && !obsidianPickup) {
                continue;
            }

            boolean friend = Forever.FRIEND.isFriend(p);
            if (!friend || p == mc.player) {
                if ((dmg >= getMinDamage(false, p) && dmg >= 0.5) || kill.flag) {
                    if (best == null || dmg > best.damage) {
                        best = new TargetData(p, dmg, kill);
                    }
                }
            } else if (antiFriendKill.getValue() && dmg > getHealth(p)) {
                return null; // 该位置会打死朋友 → 整体作废
            }
        }
        return best;
    }

    /** 位置合法性门控（is2070） */
    private boolean isPosValid(BlockPos pos, boolean allowBase, int predict) {
        if (!allowBase && !isSolidBase(pos)) return false;
        BlockPos up = pos.up();
        Block block = mc.world.getBlockState(up).getBlock();
        boolean airOrFire = block instanceof AirBlock || block == Blocks.FIRE;
        if (!airOrFire) return false;
        if (limit.getValue() && !(mc.world.getBlockState(pos.up(2)).getBlock() instanceof AirBlock)) {
            return false;
        }
        Box collisionBox = new Box(up).withMaxY(up.getY() + (lowerHitBox.getValue() ? 1 : 2));
        List<Entity> entities = snapshotEntities();
        for (Entity e : entities) {
            if (e.isRemoved() || !e.isAlive()) continue;
            Box box = e.getBoundingBox();
            if (e instanceof PlayerEntity && e != mc.player) {
                if (hBFix.getValue()) box = box.expand(0.05, 0, 0.05);
            }
            if (e instanceof EndCrystalEntity
                    && mc.player.getEyePos().squaredDistanceTo(e.getPos()) <= breakRange.getValue() * breakRange.getValue()) {
                continue; // 近距离水晶不阻挡
            }
            if (box.intersects(collisionBox)) return false;
        }
        return true;
    }

    /** 放置位完整校验（is3043）：底座 + 上方空气 + 无实体 */
    private boolean isCrystalPosValid(BlockPos pos, boolean ignoreCrystal) {
        if (!isSolidBase(pos)) return false;
        Block up = mc.world.getBlockState(pos.up()).getBlock();
        if (limit.getValue()) {
            if (up != Blocks.AIR && up != Blocks.FIRE) return false;
        } else if (up != Blocks.AIR) return false;
        if (limit.getValue() && mc.world.getBlockState(pos.up(2)).getBlock() != Blocks.AIR) return false;
        Box box = new Box(pos.getX(), pos.getY() + 1, pos.getZ(),
                pos.getX() + 1, pos.getY() + (lowerHitBox.getValue() ? 1 : 3), pos.getZ() + 1);
        List<Entity> entities = snapshotEntities();
        for (Entity e : entities) {
            if (e.isRemoved() || !e.isAlive()) continue;
            Box bb = e.getBoundingBox();
            if (e instanceof PlayerEntity && e != mc.player && hBFix.getValue()) bb = bb.expand(0.05, 0, 0.05);
            if (e instanceof EndCrystalEntity && !ignoreCrystal) continue;
            if (bb.intersects(box)) return false;
        }
        return true;
    }

    // ══════════════════════════ 放置 ══════════════════════════

    private void doPlace() {
        if (!place.getValue() || isSwapPenaltyActive()) return;
        if (strictTiming.getValue() && skip) {
            skip = false;
            return;
        }
        CalcResult result = bestResult.get();
        if (result == null || result.pos == null || result.target == null) return;

        BlockPos pos = result.pos;

        if (result.damage < getMinDamage(false, result.target)) return;

        // DamageSync：等待当前伤害达标
        if ((damageSync.getValue() || obsidianPickup)
                && currentDamage < minPlaceDamage.getValueFloat()
                && currentDamage < 5.0f
                && !placeTimer.passedMs(placeDelay.getValue())) {
            return;
        }

        // 底座模式 → 放黑曜石
        if (result.mode == PlaceMode.Obsidian && basePlace.getValue()) {
            doBasePlace(pos);
            return;
        }

        if (!isCrystalPosValid(pos, false)) return;

        // 清除上方火焰
        if (mc.world.getBlockState(pos.up()).getBlock() == Blocks.FIRE) {
            sendPacket(new PlayerActionC2SPacket(PlayerActionC2SPacket.Action.START_DESTROY_BLOCK, pos.up(), Direction.DOWN));
            sendPacket(new PlayerActionC2SPacket(PlayerActionC2SPacket.Action.STOP_DESTROY_BLOCK, pos.up(), Direction.DOWN));
            return;
        }

        boolean offhand = mc.player.getOffHandStack().getItem() == Items.END_CRYSTAL;
        boolean holding = mc.player.isHolding(Items.END_CRYSTAL);
        int prevSlot = mc.player.getInventory().selectedSlot;
        int crystalSlot = findCrystalInvSlot();
        boolean swapped = false;

        if (autoSwap.getValue() != SwapMode.None && !holding && !isSwapDelay() && crystalSlot != -1) {
            if (silentMode.is(SilentMode.Alternative)) {
                InventoryUtil.inventorySwap(crystalSlot, prevSlot);
                swapped = true;
            } else if (silentMode.is(SilentMode.Pick)) {
                sendPacket(new PickFromInventoryC2SPacket(rawSlot(crystalSlot)));
            } else {
                if (autoSwap.is(SwapMode.Silent)) {
                    swapPenaltyTimer.reset();
                }
                if (autoSwap.is(SwapMode.Normal)) {
                    swapTimer.reset();
                    if (swapBack.getValue()) {
                        swapBackSlot = prevSlot;
                    }
                }
                InventoryUtil.switchToSlot(hotbarSlot(crystalSlot));
                swapped = true;
            }
        }

        if ((crystalSlot == -1 || autoSwap.getValue() == SwapMode.None) && !holding) {
            return;
        }

        placeCrystal(pos, offhand);

        // 交换还原
        if (swapped) {
            if (silentMode.is(SilentMode.Alternative)) {
                InventoryUtil.inventorySwap(crystalSlot, prevSlot);
            } else if (autoSwap.is(SwapMode.Silent)) {
                InventoryUtil.switchToSlot(prevSlot);
            }
        }
        if (strictTiming.getValue()) {
            skip = true;
        }
    }

    private void placeCrystal(BlockPos pos, boolean offhand) {
        if (pos == null) return;
        Direction dir = BlockUtil.getClickSideStrict(pos);
        if (dir == null) dir = Direction.DOWN;
        Vec3d aim = pos.toCenterPos().offset(dir, 0.5);
        double bestDist = Double.MAX_VALUE;
        double[] offsets = {0.3, 0.7};
        for (double ox : offsets) {
            for (double oy : new double[]{0.3, 0.7, 0.9}) {
                for (double oz : offsets) {
                    Vec3d sample = new Vec3d(pos.getX() + ox, pos.getY() + oy, pos.getZ() + oz);
                    BlockHitResult hit = mc.world.raycast(new RaycastContext(mc.player.getEyePos(), sample,
                            RaycastContext.ShapeType.COLLIDER, RaycastContext.FluidHandling.NONE, mc.player));
                    double dist = hit.getPos().distanceTo(mc.player.getEyePos());
                    if ((hit.getType() == HitResult.Type.MISS || hit.getBlockPos().equals(pos))
                            && sample.distanceTo(mc.player.getEyePos()) <= placeRange.getValueFloat()
                            && dist < bestDist) {
                        aim = hit.getPos();
                        dir = hit.getSide();
                        bestDist = dist;
                    }
                }
            }
        }
        if (placeRotate.getValue() && rotate.getValue()) {
            setRotationTarget(aim);
        }
        Hand hand = offhand ? Hand.OFF_HAND : Hand.MAIN_HAND;
        Vec3d hitVec = pos.toCenterPos().offset(dir, 0.5);
        Direction finalDir = dir;
        Module.sendSequencedPacket(id -> new PlayerInteractBlockC2SPacket(hand, new BlockHitResult(hitVec, finalDir, pos, false), id));
        mc.player.swingHand(hand);
        lastPlacedPos = pos;
        breakTargetPos = pos;
        if (render.getValue()) addRenderPos(pos);
        placeTimer.reset();
    }

    // ══════════════════════════ 底座放置 ══════════════════════════

    private void doBasePlace(BlockPos pos) {
        if (!shouldBasePlace() || isSwapPenaltyActive()) return;

        int crystalInv = findCrystalInvSlot();
        boolean holdingCrystal = mc.player.getOffHandStack().isOf(Items.END_CRYSTAL) || crystalInv != -1;
        if (!holdingCrystal) return;

        int prevSlot = mc.player.getInventory().selectedSlot;
        int obsSlot = findObsidianSlot();
        Direction dir = BlockUtil.getClickSideStrict(pos);
        boolean altSilent = silentMode.is(SilentMode.Alternative);
        boolean pick = silentMode.is(SilentMode.Pick);
        boolean air = airPlace.getValue() && dir == null;

        if (altSilent && obsSlot == -1) obsSlot = InventoryUtil.findItemInventorySlot(Items.OBSIDIAN);
        if (obsSlot == -1) return;

        if ((dir != null || airPlace.getValue()) && isBasePlaceable(pos)) {
            if (obsSlot != prevSlot) {
                if (altSilent) {
                    InventoryUtil.inventorySwap(obsSlot, prevSlot);
                } else if (pick) {
                    sendPacket(new PickFromInventoryC2SPacket(rawSlot(obsSlot)));
                } else {
                    InventoryUtil.switchToSlot(hotbarSlot(obsSlot));
                }
            }
            Hand hand = Hand.MAIN_HAND;
            if (air) {
                sendPacket(new PlayerActionC2SPacket(PlayerActionC2SPacket.Action.SWAP_ITEM_WITH_OFFHAND, BlockPos.ORIGIN, Direction.DOWN));
                hand = Hand.OFF_HAND;
            }
            placeBlockPacket(pos, dir, hand);
            if (air) {
                sendPacket(new PlayerActionC2SPacket(PlayerActionC2SPacket.Action.SWAP_ITEM_WITH_OFFHAND, BlockPos.ORIGIN, Direction.DOWN));
            }
            if (placeRotate.getValue() && rotate.getValue()) {
                Vec3d center = pos.toCenterPos();
                if (dir != null) center = center.offset(dir, 0.5);
                setRotationTarget(center);
            }
            basePos = pos;
            baseTimer.reset();
            if (obsSlot != prevSlot) {
                if (altSilent) {
                    InventoryUtil.inventorySwap(obsSlot, prevSlot);
                } else if (pick) {
                    sendPacket(new PickFromInventoryC2SPacket(rawSlot(obsSlot)));
                } else {
                    InventoryUtil.switchToSlot(prevSlot);
                }
            }
        }
    }

    /** is1151：是否需要在目标脚下放底座 */
    private boolean shouldBasePlace() {
        if (basePos != null && target != null) {
            if (!isCrystalPosValid(basePos, false)) return true;
            boolean visible = isMultipointVisible(basePos);
            double dist = mc.player.getEyePos().distanceTo(basePos.toCenterPos());
            if (dist > placeRange.getValue()) return true;
            if (!visible && dist > placeWallRange.getValue() && !smartTrace.getValue()) return true;
            if (damageAtPlace(explosionPos(basePos), target, predictTicks(), basePos) >= getMinDamage(false, target)) {
                return false;
            }
        }
        return baseTimer.passedMs(3000);
    }

    private void placeBlockPacket(BlockPos pos, Direction dir, Hand hand) {
        if (dir == null) {
            Vec3d hitVec = pos.toCenterPos();
            Module.sendSequencedPacket(id -> new PlayerInteractBlockC2SPacket(hand, new BlockHitResult(hitVec, Direction.DOWN, pos, false), id));
        } else {
            BlockPos clickPos = pos.offset(dir);
            Direction side = dir.getOpposite();
            Vec3d hitVec = pos.toCenterPos().add(Vec3d.of(dir.getVector()).multiply(0.5));
            Module.sendSequencedPacket(id -> new PlayerInteractBlockC2SPacket(hand, new BlockHitResult(hitVec, side, clickPos, false), id));
        }
        mc.player.swingHand(hand);
    }

    private boolean isBasePlaceable(BlockPos pos) {
        if (!mc.world.getBlockState(pos).isReplaceable()) return false;
        return !BlockUtil.hasEntity(pos, false);
    }

    // ══════════════════════════ 破坏 ══════════════════════════

    private void doBreak() {
        if (!breakEnabled.getValue() || isSwapPenaltyActive()) return;
        if (isInvalidTarget(target) || isInvincible(target)) return;
        if (resync.getValue() && !rotationResetTimer.passedMs(200)) return;

        EndCrystalEntity best = null;
        double bestDmg = -1;
        List<Entity> entities = snapshotEntities();
        for (Entity e : entities) {
            if (!(e instanceof EndCrystalEntity crystal)) continue;
            if (!isCrystalValid(crystal)) continue;
            double targetDmg = damageAtCrystal(crystal.getPos(), target, predictTicks());
            double selfDmg = damageAtCrystal(crystal.getPos(), mc.player, 0);
            KillState kill = getKillState(target, targetDmg);
            if (balance.getValue() && !(targetDmg > selfDmg) && !forceSuicide.getValue() && !kill.flag) {
                continue;
            }
            if (isSuicide(true, selfDmg, targetDmg, kill, target)) continue;
            if (targetDmg >= getMinDamage(true, target) && targetDmg > bestDmg) {
                bestDmg = targetDmg;
                best = crystal;
            }
        }
        if (best == null) return;
        if (breakRotate.getValue() && rotate.getValue()) {
            setRotationTarget(best.getPos());
        }
        attackCrystal(best);
        breakTargetPos = best.getBlockPos().down();
    }

    private boolean isCrystalValid(EndCrystalEntity crystal) {
        if (crystal.isRemoved() || target == null) return false;
        if ((crystal.age < ticksExisted.getValue() && !isMining()) || !crystal.isAlive()) return false;
        return mc.player.getEyePos().distanceTo(crystal.getPos())
                <= (mc.player.canSee(crystal) ? breakRange.getValue() : breakWallRange.getValue());
    }

    private void attackCrystal(EndCrystalEntity crystal) {
        if (crystal.getId() == breakEntityId && attackTimer.passedMs(500) && crystal.isAlive() && !crystal.isRemoved()) {
            consecutiveBreaks++;
        } else {
            consecutiveBreaks = 0;
        }
        breakEntityId = crystal.getId();
        if (consecutiveBreaks >= 5) attackTimer.reset();

        int factor = Math.max(1, breakFactor.getValueInt());
        for (int i = 0; i < factor; i++) {
            sendPacket(PlayerInteractEntityC2SPacket.attack(crystal, mc.player.isSneaking()));
            mc.player.swingHand(Hand.MAIN_HAND);
        }
        mc.player.resetLastAttackedTicks();
        breakTimer.reset();
        attackTimer.reset();
    }

    // ══════════════════════════ Instant 破水晶 ══════════════════════════

    private void handleCrystalSpawn(EntitySpawnS2CPacket spawn) {
        if (target == null || isInvalidTarget(target)) return;
        Vec3d pos = new Vec3d(spawn.getX(), spawn.getY(), spawn.getZ());
        if (lastPlacedPos != null && pos.squaredDistanceTo(lastPlacedPos.toCenterPos()) <= 3.0) {
            placedTimestamps.add(System.currentTimeMillis());
        }
        if (instant.is(InstantMode.None) || !breakEnabled.getValue() || isInvincible(target)) return;
        if (isMining() && await.getValue()) return;
        if (mc.player.getEyePos().distanceTo(pos) > (canTrace(pos) ? breakRange.getValue() : breakWallRange.getValue())) {
            return;
        }

        double targetDmg = damageAtCrystal(pos, target, predictTicks());
        double selfDmg = damageAtCrystal(pos, mc.player, 0);
        KillState kill = getKillState(target, targetDmg);
        if (balance.getValue() && !(targetDmg > selfDmg) && !forceSuicide.getValue() && !kill.flag) return;
        if (targetDmg < getMinDamage(true, target) || isSuicide(true, selfDmg, targetDmg, kill, target)) return;

        BlockPos floored = BlockPos.ofFloored(pos);
        if (instant.is(InstantMode.Strict) && lastPlacedPos != null && lastPlacedPos.equals(floored)) return;

        if (breakRotate.getValue() && rotate.getValue()) {
            setRotationTarget(pos);
        }
        breakTargetPos = floored;
        pendingBreakId = spawn.getEntityId();

        // Sequential：破后立即放
        if (sequential.getValue() != SequentialMode.None && !placedThisCycle) {
            placeTimer.reset();
            doPlace();
            if (sequential.is(SequentialMode.Strict)) {
                placedThisCycle = true;
            }
        }
    }

    // ══════════════════════════ 目标 / 无敌 ══════════════════════════

    /** is1149：目标无效返回 true */
    private boolean isInvalidTarget(PlayerEntity e) {
        if (e == null) return true;
        if (forceSuicide.getValue()) return e != mc.player;
        return Forever.FRIEND.isFriend(e)
                || !e.isAlive()
                || e.isDead()
                || e.distanceTo(mc.player) > targetRange.getValueFloat()
                || isServerSideDead(e)
                || mc.player == e
                || e.isSpectator()
                || e.getAbilities().creativeMode;
    }

    /** is1155 + is1156：无敌超时 */
    private boolean isInvincible(PlayerEntity player) {
        if (isSelfInvincible()) return false;
        if (!assumeInvincibility.getValue()) return false;
        Long seen = firstSeenTime.get(player.getUuid());
        if (seen == null) return false;
        return (System.currentTimeMillis() - seen) <= (long) (invincTimeout.getValueFloat() * 1000);
    }

    private boolean isSelfInvincible() {
        return self.getValue() && (float) mc.player.age / 20.0f < invincTimeout.getValueFloat();
    }

    private boolean isServerSideDead(LivingEntity e) {
        Boolean dead = serverDead.get(e.getId());
        return dead != null && dead;
    }

    /** getAutoCrystalMode_71882 */
    private KillState getKillState(LivingEntity e, double damage) {
        boolean canKill = damage >= getHealth(e);
        boolean hasTotem = e.getOffHandStack().isOf(Items.TOTEM_OF_UNDYING)
                || e.getMainHandStack().isOf(Items.TOTEM_OF_UNDYING);
        if (!canKill) return hasTotem ? KillState.Pop : KillState.Kill;
        return KillState.None;
    }

    /** get847：最低伤害阈值（player 为该次候选目标） */
    private double getMinDamage(boolean hit, PlayerEntity player) {
        if (player == null) return 0.0;
        if (obsidianPickup) return 0.1;
        if (facePlace.getValue() && (getHealth(player) <= facePlaceHealth.getValueFloat()
                || getArmorDurability(player) <= facePlaceArmor.getValue())) {
            return 0.6;
        }
        if (mc.world.getBlockState(mc.player.getBlockPos()).isOf(Blocks.NETHER_PORTAL)) return 0.6;
        double dmg = hit ? minBreakDamage.getValue() : minPlaceDamage.getValue();
        if (damageSync.getValue()) dmg = getHealth(player);
        return Math.min(dmg, getHealth(player));
    }

    /** get848：最大自伤 */
    private double getMaxSelfDamage(boolean hit) {
        if (isSelfInvincible()) return 999.0;
        return hit ? maxSelfHit.getValue() : maxSelfPlace.getValue();
    }

    /** is849：反自杀，返回 true = 跳过 */
    private boolean isSuicide(boolean hit, double selfDamage, double targetDamage, KillState kill, PlayerEntity player) {
        boolean hasTotem = mc.player.getOffHandStack().isOf(Items.TOTEM_OF_UNDYING)
                || mc.player.getMainHandStack().isOf(Items.TOTEM_OF_UNDYING);
        if (forceSuicide.getValue()) return false;
        if (isSelfInvincible()) selfDamage = 0.0;
        if (selfDamage >= getHealth(mc.player) && antiSuicide.getValue() && (kill != KillState.Kill || !hasTotem)) {
            return true;
        }
        if (kill == KillState.Kill) return false;
        if (!hit && selfDamage > 0.0 && targetDamage / selfDamage < damageRatio.getValueFloat()) {
            return true;
        }
        return targetDamage < getHealth(player)
                && (targetDamage < getMinDamage(false, player) || selfDamage > getMaxSelfDamage(false));
    }

    private void checkObsidianPickup() {
        obsidianPickup = false;
        if (target == null || nullCheck()) return;
        List<Entity> entities = snapshotEntities();
        for (Entity e : entities) {
            if (e instanceof ItemEntity item
                    && item.getStack().getItem() == Items.OBSIDIAN
                    && item.getStack().getCount() >= 8
                    && e.isAlive()) {
                Box b = target.getBoundingBox();
                if (e.getBoundingBox().intersects(b.withMinY(b.getCenter().getY()).expand(0.5, 0, 0.5))) {
                    obsidianPickup = true;
                    return;
                }
            }
        }
    }

    // ══════════════════════════ 暂停判定 ══════════════════════════

    private boolean isPaused() {
        if (nullCheck() || isInvalidTarget(target)) return true;
        if (mc.player.isSleeping()) return true;
        if (mc.player.isUsingItem() && eatPause.getValue()) return true;
        if ((mc.interactionManager.isBreakingBlock() || isMining()) && minePause.getValue()) return true;
        if (forceSuicide.getValue()) return false;
        return getHealth(mc.player) < healthPause.getValueFloat();
    }

    /** is1157 简化版：挖矿中 */
    private boolean isMining() {
        return mineIgnore.getValue() && mc.interactionManager.isBreakingBlock();
    }

    // ══════════════════════════ 工具 ══════════════════════════

    private int predictTicks() {
        return extrapolation.getValue() ? extrapTicks.getValueInt() : 0;
    }

    /** 实体快照（用 ThreadManager 线程安全快照，供异步搜索线程读取） */
    private List<Entity> snapshotEntities() {
        List<Entity> list = new ArrayList<>();
        for (Entity e : Forever.THREAD.getEntities()) list.add(e);
        return list;
    }

    private Vec3d explosionPos(BlockPos pos) {
        return new Vec3d(pos.getX() + 0.5, pos.getY() + 1.0, pos.getZ() + 0.5);
    }

    private boolean isSolidBase(BlockPos pos) {
        Block block = mc.world.getBlockState(pos).getBlock();
        return block == Blocks.BEDROCK || block == Blocks.OBSIDIAN;
    }

    private float getHealth(LivingEntity e) {
        return e.getHealth() + e.getAbsorptionAmount();
    }

    private float getArmorDurability(PlayerEntity p) {
        float min = 100f;
        for (ItemStack stack : p.getInventory().armor) {
            if (stack.isEmpty()) continue;
            float dur = 100f - (int) ((1f - ((float) (stack.getMaxDamage() - stack.getDamage()) / (float) stack.getMaxDamage())) * 100f);
            min = Math.min(min, dur);
        }
        return min;
    }

    private boolean hasArmor(PlayerEntity p) {
        for (ItemStack stack : p.getInventory().armor) {
            if (!stack.isEmpty()) return true;
        }
        return false;
    }

    /** get1900：放置位伤害（忽略底座方块阻挡） */
    private float damageAtPlace(Vec3d explosionPos, PlayerEntity entity, int predict, BlockPos basePos) {
        DamageUtils.RaycastFactory factory = DamageUtils.getOverridingHitFactory(basePos, Blocks.AIR.getDefaultState());
        if (predict <= 0) {
            return DamageUtils.explosionDamage(entity, entity.getPos(), entity.getBoundingBox(), explosionPos, 12.0F, factory);
        }
        return DamageUtils.explosionDamage(entity, getPredictPos(entity, predict), getPredictBox(entity, predict), explosionPos, 12.0F, factory);
    }

    /** 已有水晶伤害（不忽略底座） */
    private float damageAtCrystal(Vec3d explosionPos, PlayerEntity entity, int predict) {
        if (predict <= 0) {
            return DamageUtils.explosionDamage(entity, entity.getPos(), entity.getBoundingBox(), explosionPos, 12.0F, DamageUtils.HIT_FACTORY);
        }
        return DamageUtils.explosionDamage(entity, getPredictPos(entity, predict), getPredictBox(entity, predict), explosionPos, 12.0F, DamageUtils.HIT_FACTORY);
    }

    private Vec3d getPredictPos(LivingEntity e, int ticks) {
        Vec3d vel = e.getVelocity();
        double mx = MathHelper.clamp(vel.x, -0.6, 0.6);
        double my = MathHelper.clamp(vel.y, -0.34, 0.34);
        double mz = MathHelper.clamp(vel.z, -0.6, 0.6);
        return e.getPos().add(mx * ticks, my * ticks, mz * ticks);
    }

    private Box getPredictBox(LivingEntity e, int ticks) {
        return e.getBoundingBox().offset(getPredictPos(e, ticks).subtract(e.getPos()));
    }

    /** is2432：multipoint 可见性 */
    private boolean isMultipointVisible(BlockPos pos) {
        for (Vec3d v : getMultiPointList(pos)) {
            if (isTraceVisible(mc.player.getEyePos(), v)) return true;
        }
        return false;
    }

    private boolean canTrace(Vec3d v) {
        return isTraceVisible(mc.player.getEyePos(), v);
    }

    private boolean isTraceVisible(Vec3d start, Vec3d end) {
        if (end.distanceTo(start) > 256) return false;
        BlockHitResult hit = mc.world.raycast(new RaycastContext(start, end,
                RaycastContext.ShapeType.COLLIDER, RaycastContext.FluidHandling.NONE, mc.player));
        return hit.getType() == HitResult.Type.MISS
                || hit.getPos().equals(end)
                || hit.getBlockPos().equals(BlockPos.ofFloored(end));
    }

    /** AutoCraftMode 移植 */
    private List<Vec3d> getMultiPointList(BlockPos pos) {
        List<Vec3d> base;
        switch (multipoint.getValue()) {
            case Fast:
                base = List.of(new Vec3d(0.5, 0.5, 0.5));
                break;
            case X2:
                base = List.of(new Vec3d(0.5, 0.05, 0.5), new Vec3d(0.5, 1.0, 0.5));
                break;
            case X4:
                base = List.of(new Vec3d(0.05, 0.05, 0.05), new Vec3d(0.05, 0.05, 0.95),
                        new Vec3d(0.95, 0.05, 0.05), new Vec3d(0.95, 0.05, 0.95));
                break;
            default:
                base = List.of(new Vec3d(0.05, 0.05, 0.05), new Vec3d(0.05, 0.05, 0.95),
                        new Vec3d(0.05, 0.95, 0.05), new Vec3d(0.05, 0.95, 0.95),
                        new Vec3d(0.95, 0.05, 0.05), new Vec3d(0.95, 0.05, 0.95),
                        new Vec3d(0.95, 0.95, 0.05), new Vec3d(0.95, 0.95, 0.95));
        }
        List<Vec3d> list = new ArrayList<>();
        for (Vec3d v : base) {
            Vec3d add = v.add(pos.getX(), pos.getY(), pos.getZ());
            if (multipoint.is(MultiPoint.X4) && mc.player.getEyeY() > pos.getY() + 1) {
                add = add.add(0, 0.9, 0);
            }
            list.add(add);
        }
        return list;
    }

    private boolean isSwapPenaltyActive() {
        return !swapPenaltyTimer.passedMs(swapPenalty.getValue());
    }

    private boolean isSwapDelay() {
        return autoSwap.is(SwapMode.Normal) && !swapTimer.passedMs(swapDelay.getValue());
    }

    private int findCrystalInvSlot() {
        return InventoryUtil.findItemInventorySlot(Items.END_CRYSTAL);
    }

    private int findObsidianSlot() {
        return InventoryUtil.findItemInventorySlot(Items.OBSIDIAN);
    }

    private int hotbarSlot(int invSlot) {
        return invSlot >= 36 ? invSlot - 36 : invSlot;
    }

    private int rawSlot(int invSlot) {
        return invSlot >= 36 ? invSlot - 36 : invSlot;
    }

    private void setRotationTarget(Vec3d pos) {
        if (pos == null) return;
        this.rotationTarget = pos;
        this.rotationResetTimer.reset();
    }

    private void addRenderPos(BlockPos pos) {
        if (multiFade.getValue()) {
            renderList.add(new RenderPos(pos, System.currentTimeMillis()));
        } else {
            renderList.clear();
            renderList.add(new RenderPos(pos, System.currentTimeMillis()));
        }
    }

    // ══════════════════════════ 渲染 ══════════════════════════

    @Override
    public void onRender3D(MatrixStack matrixStack) {
        if (!render.getValue() || nullCheck()) return;

        long now = System.currentTimeMillis();
        renderList.removeIf(rp -> fade.getValue() && now - rp.time > fadeTime.getValue());

        for (RenderPos rp : renderList) {
            float progress = fade.getValue()
                    ? Math.min(1f, (now - rp.time) / (float) fadeTime.getValue())
                    : 0f;
            float alpha = 1f - progress;
            if (alpha <= 0) continue;
            Box box = new Box(rp.pos);
            Color f = ColorUtil.injectAlpha(fill.getValue(), (int) (fill.getValue().getAlpha() * alpha));
            Color o = ColorUtil.injectAlpha(outline.getValue(), (int) (outline.getValue().getAlpha() * alpha));
            Render3DUtil.draw3DBox(matrixStack, box, f, o, true, true, lineWidth.getValueFloat());
        }

        // 当前最佳放置目标
        CalcResult best = bestResult.get();
        if (best != null && best.pos != null) {
            Box box = new Box(best.pos);
            Render3DUtil.drawBox(matrixStack, box, outline.getValue(), lineWidth.getValueFloat());
        }

        // 预测路径线
        if (drawExtrap.getValue() && extrapolation.getValue() && target != null && !isInvalidTarget(target)) {
            int ticks = extrapTicks.getValueInt();
            for (int i = 1; i <= ticks; i++) {
                Box prev = getPredictBox(target, i - 1);
                Box next = getPredictBox(target, i);
                Vec3d a = new Vec3d(MathHelper.lerp(0.5, prev.minX, prev.maxX), prev.minY, MathHelper.lerp(0.5, prev.minZ, prev.maxZ));
                Vec3d b = new Vec3d(MathHelper.lerp(0.5, next.minX, next.maxX), next.minY, MathHelper.lerp(0.5, next.minZ, next.maxZ));
                Render3DUtil.drawLine(a, b, outline.getValue());
            }
        }
    }
}
