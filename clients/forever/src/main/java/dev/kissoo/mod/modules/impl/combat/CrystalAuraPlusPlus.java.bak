/**
 * CrystalAura++ (水晶光环++)
 * <p>
 * 移植自 OpenMio (MioClient) 的 AutoCrystal。与 CrystalBot 并存。
 * 异步 VirtualThread 搜索 + Instant 破水晶 + Sequential + MultiPoint 放置
 * + AutoSwap + BasePlace 黑曜石 + FacePlace + 反自杀/平衡 + 无敌超时 + 渲染淡入。
 */
public class CrystalAuraPlusPlus extends Module {

    public static CrystalAuraPlusPlus INSTANCE;

    // ── 枚举 ──
    private enum Page { Place, Break, Target, Rotation, Swap, Misc, Render }

    private enum MultiPoint { Fast, X2, X4, X8 }

    private enum InstantMode { Always, Strict, None }

    private enum SequentialMode { None, Strict, Strong }

    private enum SwapMode { None, Normal, Silent }

    private enum SilentMode { Normal, Alternative, Pick }

    /** 放置结果模式：越低越优先（普通放置 > 穿墙 > 放底座） */
    private enum PlaceMode { None, RayTrace, Obsidian }

    /** 击杀状态：NONE=打不死 / POP=有图腾会弹 / KILL=会死；flag=true 表示会死或弹图腾 */
    private enum KillState {
        None(false), Pop(true), Kill(true);
        final boolean flag;

        KillState(boolean flag) {
            this.flag = flag;
        }
    }

